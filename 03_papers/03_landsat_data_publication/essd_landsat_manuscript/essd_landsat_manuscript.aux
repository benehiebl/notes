\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Regression performance (MAE, RMSE, R\textsuperscript  {2}) for leaf type cover (LTC) prediction, evaluated on two test datasets. X/X/X refers to the computation of the evaluation metrics, being directly from plot location, importance-weighting, and best-match (see Sec. \ref  {sec:evaluation} and Appendix \ref  {sec:appendix_metrics}). MAE and RMSE are reported as $\%_{cover}$.\relax }}{9}{table.caption.5}\protected@file@percent }
\newlabel{tab:regression_report}{{3}{9}{Regression performance (MAE, RMSE, R\textsuperscript {2}) for leaf type cover (LTC) prediction, evaluated on two test datasets. X/X/X refers to the computation of the evaluation metrics, being directly from plot location, importance-weighting, and best-match (see Sec. \ref {sec:evaluation} and Appendix \ref {sec:appendix_metrics}). MAE and RMSE are reported as $\%_{cover}$.\relax }{table.caption.5}{}}
