@misc{chen_simple_2020,
	title = {A {Simple} {Framework} for {Contrastive} {Learning} of {Visual} {Representations}},
	url = {http://arxiv.org/abs/2002.05709},
	doi = {10.48550/arXiv.2002.05709},
	abstract = {This paper presents SimCLR: a simple framework for contrastive learning of visual representations. We simplify recently proposed contrastive self-supervised learning algorithms without requiring specialized architectures or a memory bank. In order to understand what enables the contrastive prediction tasks to learn useful representations, we systematically study the major components of our framework. We show that (1) composition of data augmentations plays a critical role in defining effective predictive tasks, (2) introducing a learnable nonlinear transformation between the representation and the contrastive loss substantially improves the quality of the learned representations, and (3) contrastive learning benefits from larger batch sizes and more training steps compared to supervised learning. By combining these findings, we are able to considerably outperform previous methods for self-supervised and semi-supervised learning on ImageNet. A linear classifier trained on self-supervised representations learned by SimCLR achieves 76.5\% top-1 accuracy, which is a 7\% relative improvement over previous state-of-the-art, matching the performance of a supervised ResNet-50. When fine-tuned on only 1\% of the labels, we achieve 85.8\% top-5 accuracy, outperforming AlexNet with 100X fewer labels.},
	urldate = {2026-03-25},
	publisher = {arXiv},
	author = {Chen, Ting and Kornblith, Simon and Norouzi, Mohammad and Hinton, Geoffrey},
	month = jul,
	year = {2020},
	note = {arXiv:2002.05709 [cs]},
	keywords = {Computer Science - Computer Vision and Pattern Recognition, Computer Science - Machine Learning, deep, Statistics - Machine Learning},
	file = {PDF:/home/bene/Desktop/repos/literature/2002.05709v3.pdf:application/pdf},
}

@article{midolo_sixty_2026,
	title = {Sixty years of plant community change in {Europe} indicate a shift toward nutrient-richer and denser vegetation},
	volume = {12},
	url = {https://www.science.org/doi/10.1126/sciadv.aeb2493},
	doi = {10.1126/sciadv.aeb2493},
	abstract = {Anthropogenic impacts are reshaping plant biodiversity patterns, yet how community-composition shifts track environmental change at large spatial and temporal scales remains unclear. Here, we quantified trends in community-mean plant ecological indicator values (light, temperature, soil moisture, soil nitrogen, and soil reaction) across European vegetation between 1960 and 2020. We used spatiotemporal interpolation based on 644,524 plots and analyzed 18,345 time series encompassing diverse habitats. We found a clear shift in community composition over the past six decades with a steep increase in nitrogen-demanding species across all main habitat types, accompanied by a moderate increase in shade-tolerant species. Forest communities shifted toward species associated with higher soil pH, while wetland communities showed a decline in moisture-dependent species over time. Conversely, temperature indicator values were largely stable, except for recent thermophilization in alpine habitats. Our results indicate a widespread trend toward denser vegetation driven by eutrophication and changes in management practices.},
	number = {15},
	urldate = {2026-04-13},
	journal = {Science Advances},
	publisher = {American Association for the Advancement of Science},
	author = {Midolo, Gabriele and Clark, Adam Thomas and Chytr{\'y}, Milan and Essl, Franz and Dullinger, Stefan and Jandt, Ute and Bruelheide, Helge and Dengler, J{\"u}rgen and Axmanov{\'a}, Irena and A{\'c}i{\'c}, Svetlana and Argagnon, Olivier and Biurrun, Idoia and Bonari, Gianmaria and Chiarucci, Alessandro and {\'C}u{\v s}terevska, Renata and De Frenne, Pieter and De Sanctis, Michele and Div{\'i}{\v s}ek, Jan and Dole{\v z}al, Ji{\v r}{\'i} and Dziuba, Tetiana and Ejrn{\ae}s, Rasmus and Garbolino, Emmanuel and Jentsch, Anke and Jim{\'e}nez-Alfaro, Borja and Lenoir, Jonathan and Moeslund, Jesper Erenskjold and Napoleone, Francesca and Rumpf, Sabine B. and Svenning, Jens-Christian and Swacha, Grzegorz and Tatarenko, Irina and Ve{\v c}e{\v r}a, Martin and Vynokurov, Denys and Keil, Petr},
	month = apr,
	year = {2026},
	keywords = {eco},
	pages = {eaeb2493},
	annote = {Summary of Academic Paper's Technical Approach
 
1. Title and Authors of the Paper
Title: Sixty years of plant community change in Europe indicate a shift toward nutrient-richer and denser vegetation
Authors: Gabriele Midolo, Adam Thomas Clark, Milan Chytr{\'y}, Franz Essl, Stefan Dullinger, Ute Jandt, Helge Bruelheide, J{\"u}rgen Dengler, Irena Axmanov{\'a}, Svetlana A{\'c}i{\'c}, Olivier Argagnon, Idoia Biurrun, Gianmaria Bonari, Alessandro Chiarucci, Renata {\'C}u{\v s}terevska, Pieter De Frenne, Michele De Sanctis, Jan Div{\'i}{\v s}ek, Ji{\v r}{\'i} Dole{\v z}al, Tetiana Dziuba, Rasmus Ejrn{\ae}s, Emmanuel Garbolino, Anke Jentsch, Borja Jim{\'e}nez-Alfaro, Jonathan Lenoir, Jesper Erenskjold Moeslund, Francesca Napoleone, Sabine B. Rumpf, Jens-Christian Svenning, Grzegorz Swacha, Irina Tatarenko, Martin Ve{\v c}e{\v r}a, Denys Vynokurov, and Petr Keil
Published: Science Advances 12, eaeb2493 (10 April 2026)

2. Quick Overview


Why is it relevant? While local species richness often shows no net change over time, community composition is shifting substantially, and a continent-wide, multi-indicator assessment of how plant communities track environmental change across Europe was previously missing.


What was done? The authors used spatiotemporal interpolation (random forests) on 644,524 vegetation plots and 18,345 resurvey time series to reconstruct 60-year trends in community-mean ecological indicator values (EIVs) for light, temperature, moisture, nitrogen, and soil reaction across European habitats.


What is the main outcome? Nitrogen-demanding species have increased steeply and consistently across all major European habitat types, accompanied by a rise in shade-tolerant species, pointing to a widespread shift toward denser, nutrient-richer vegetation driven by eutrophication and land-use change.



3. Main Goal and Fundamental Concept
The primary objective was to reconstruct how the ecological preferences of European plant communities --- as reflected by indicator species --- have changed across the continent between 1960 and 2020, and to determine which environmental drivers (climate warming, nutrient enrichment, land-use change) have left the strongest imprint on community composition. The fundamental concept relies on bioindication: since each plant species has a characteristic realized niche position, the average ecological indicator values of co-occurring species in a plot can serve as a proxy for local environmental conditions, and shifts in these averages over time reveal underlying environmental change.

4. Technical Approach
The study combined two major European vegetation databases --- the European Vegetation Archive (EVA, {\textasciitilde}623,000 single-survey plots) and ReSurveyEurope ({\textasciitilde}21,600 resurvey time series with {\textasciitilde}57,000 observations). For each plot, unweighted community-mean ecological indicator values (CMEIVs) were calculated using the EIVE consensus system (covering 13,874 vascular plant taxa) across five indicators: light, temperature, soil moisture, soil nitrogen, and soil reaction.
The core analytical approach was spatiotemporal interpolation using random forests. Each plot's CMEIV was modeled as a function of geographic coordinates (northing, easting), elevation, sampling year, plot size, species richness, and habitat type (forest, grassland, scrub, wetland). The random forest models were trained on 644,524 plots (including one randomly selected observation per resurvey time series) and used to predict CMEIV for every plot location across each year from 1960 to 2020, holding plot size at habitat-specific representative values. Changes were quantified as the difference between predicted 2020 and 1960 values.
As an independent validation, the authors analyzed actual CMEIV changes observed in the ReSurveyEurope time series using linear mixed-effects models, with habitat type $\times$ sampling year as the main fixed effect, plot size as a covariate, and plot nested within dataset as a random effect. Additional models were trained with EUNIS level 2 habitat as a predictor to resolve finer habitat-specific trends.

5. Distinctive Features


Unprecedented scale: This is the first continent-wide assessment that simultaneously tracks temporal dynamics across five abiotic gradients in European plant communities, using over 640,000 vegetation plots spanning six decades.


Spatiotemporal interpolation from single-survey data: Rather than relying solely on scarce resurvey time series, the authors exploited the spatial and temporal autocorrelation inherent in single-survey vegetation data to fill gaps in the "space-time cube," enabling continuous temporal reconstructions even in regions with no repeated surveys.


Independent dual validation: Conclusions from the interpolation approach were cross-checked against actual field-collected time series from ReSurveyEurope, providing confidence that patterns derived from static data reflect real temporal shifts.


Multi-indicator, multi-habitat framework: By analyzing five indicator variables across four broad and 25+ finer habitat types simultaneously, the study reveals habitat-dependent responses and allows comparison of the relative importance of different environmental drivers.



6. Experimental Setup and Results
Data: 644,524 vegetation plots from EVA and ReSurveyEurope, filtered for geographic location (Europe, excluding peripheral regions), habitat type (forest, grassland, scrub, wetland via EUNIS classification), plot size (100--1000 m$^2$ for forests; 1--100 m$^2$ for others), and sampling year (1945--2023). EIVs from the EIVE 1.0 consensus system were required for $\geq$80\% of species per plot.
Model performance: Random forest models achieved R$^2$ values ranging from 0.78 (nitrogen) to 0.93 (temperature). Validation against ReSurveyEurope time series yielded Pearson correlations of 0.51--0.61 between predicted and observed CMEIV changes.
Key results:


Nitrogen: The strongest and most ubiquitous shift --- a mean increase of +0.25 CMEIV from 1960 to 2020, with 62\% of plots increasing by at least 0.1. Consistent across all four habitat types; most pronounced in deciduous forests, dry grasslands, and several scrub and wetland types.


Light: A moderate decline (mean $-$0.12 CMEIV), most marked in grasslands and wetlands (bogs and fens), indicating denser vegetation and reduced suitability for light-demanding species.


Temperature: Largely stable across most habitats, with a notable exception: clear thermophilization in alpine and subalpine scrub and grasslands, particularly in the last two decades.


Moisture: Substantial decline in wetlands (mean $-$0.20 CMEIV), suggesting impacts of hydrological modification. Conversely, moisture increased in some dry, nutrient-poor habitats.


Soil reaction (pH): Weak negative trends in grasslands and wetlands; positive trends in forests and acidic habitats (tundra, bogs), consistent with post-1980s recovery from acid rain.


The resurvey-based mixed-effects models broadly corroborated these patterns, though with some differences in magnitude (e.g., a more pronounced light decline in forests and stronger temperature trends).

7. Advantages and Limitations
Advantages:


Massive dataset provides robust, continent-wide inference with fine spatial resolution.


The spatiotemporal interpolation approach overcomes the patchy and uneven distribution of resurvey time series.


Using an independent habitat classification system (EUNIS) avoids circularity with EIVs and mitigates regression-to-the-mean artifacts.


Results are consistent across multiple analytical approaches (unweighted vs. cover-weighted means; with and without tree/shrub species), reinforcing robustness.


Limitations:


EIV variables are inherently correlated both at species and community levels, complicating causal attribution of observed shifts to individual drivers (e.g., nitrogen shifts in wetlands correlate with both soil pH and temperature changes).


EIVs capture environmental conditions only indirectly; the nitrogen indicator may partly reflect general vegetation density or productivity rather than soil nitrogen alone.


Static EIV assignments do not account for intraspecific variability or regional differences in ecological optima, nor for potential time-lag responses.


The interpolation approach, while validated, still relies on the assumption that spatial gradients can inform temporal trends.


Geographic and temporal coverage, while extensive, remains uneven across Europe.



8. Conclusion
Midolo et al. (2026) deliver the first comprehensive, continent-scale reconstruction of how European plant community composition has shifted along five key environmental gradients over six decades. The dominant signal is a pervasive increase in nitrogen-demanding species across virtually all habitat types, accompanied by declining light indicator values --- together pointing to a widespread trend toward denser, more nutrient-rich vegetation. This trend is attributed to the interacting effects of eutrophication (from agricultural fertilization and atmospheric deposition), reduced management intensity, and possibly CO$_2$ fertilization. Temperature-related shifts, by contrast, remain modest except in alpine environments. The study's strength lies in its unprecedented data scale and its novel use of spatiotemporal interpolation to overcome limitations of sparse resurvey data, though the inherent correlations among EIV variables caution against simplistic causal interpretation. The findings underscore that eutrophication and land-use change --- not just climate warming --- are primary agents reshaping European plant biodiversity, with clear implications for conservation strategies centered on nutrient reduction and the maintenance of open, traditionally managed landscapes.

},
	file = {PDF:/home/bene/Desktop/repos/literature/midolo_2026_denser_vegetation.pdf:application/pdf},
}

@misc{feng_tessera_2026,
	title = {{TESSERA}: {Temporal} {Embeddings} of {Surface} {Spectra} for {Earth} {Representation} and {Analysis}},
	shorttitle = {{TESSERA}},
	url = {http://arxiv.org/abs/2506.20380},
	doi = {10.48550/arXiv.2506.20380},
	abstract = {Satellite Earth-observation (EO) time series in the optical and microwave ranges of the electromagnetic spectrum are often irregular due to orbital patterns and cloud obstruction. Compositing addresses these issues but loses information with respect to vegetation phenology, which is critical for many downstream tasks. Instead, we present TESSERA, a pixel-wise foundation model for multi-modal (Sentinel-1/2) EO time series that learns robust, label-efficient embeddings. During model training, TESSERA uses Barlow Twins and sparse random temporal sampling to enforce invariance to the selection of valid observations. We employ two key regularizers: global shuffling to decorrelate spatial neighborhoods and mix-based regulation to improve invariance under extreme sparsity. We find that for diverse classification, segmentation, and regression tasks, TESSERA embeddings deliver state-of-the-art accuracy with high label efficiency, often requiring only a small task head and minimal computation. To democratize access, adhere to FAIR - principles, and simplify use, we release global, annual, 10m, pixel-wise int8 embeddings together with open weights/code and lightweight adaptation heads, thus providing practical tooling for large-scale retrieval and inference at planetary scale. All code and data are available at: https://github.com/ucam-eo/tessera.},
	urldate = {2026-07-09},
	publisher = {arXiv},
	author = {Feng, Zhengpeng and Atzberger, Clement and Jaffer, Sadiq and Knezevic, Jovana and Sormunen, Silja and Young, Robin and Lisaius, Madeline C. and Immitzer, Markus and Jackson, Toby and Ball, James and Coomes, David A. and Madhavapeddy, Anil and Blake, Andrew and Keshav, Srinivasan},
	month = apr,
	year = {2026},
	note = {arXiv:2506.20380 [cs.LG]},
	keywords = {Computer Science - Machine Learning, deep, rs},
	file = {Preprint PDF:/home/bene/Zotero/storage/6ULCK9F7/Feng et al. - 2026 - TESSERA Temporal Embeddings of Surface Spectra for Earth Representation and Analysis.pdf:application/pdf;Snapshot:/home/bene/Zotero/storage/DBYL953F/2506.html:text/html},
}

@misc{ball_geospatial_2026,
	title = {Geospatial foundation models enable data-efficient tree species mapping in temperate mountain forests},
	copyright = {\copyright{} 2026, Posted by openRxiv. This pre-print is available under a Creative Commons License (Attribution-NonCommercial-NoDerivs 4.0 International), CC BY-NC-ND 4.0, as described at http://creativecommons.org/licenses/by-nc-nd/4.0/},
	url = {https://www.biorxiv.org/content/10.64898/2026.02.23.707022v3},
	doi = {10.64898/2026.02.23.707022},
	abstract = {Accurate mapping of tree species from satellite data remains challenging in heterogeneous mountain forests due to environmental gradients, mixed stands, limited availability of high-purity training labels, and strong illumination-angle effects. Recent geospatial foundation models offer a new approach by learning generic, cloud-agnostic, information-rich representations from large multi-sensor archives suitable for a range of downstream tasks, but their ecological utility for species-level mapping remains incompletely understood. Here, we evaluate two geospatial foundation-model embeddings, AlphaEarth and Tessera, for tree species classification in the Trentino region of northern Italy, using parcel-level forest inventories as reference data (18 species and species groups). We compare their performance against conventional Sentinel-1+2 satellite composites across a series of controlled experiments examining classification accuracy, label efficiency, classifier complexity, robustness to label impurity, and temporal transferability. Foundation-model embeddings consistently outperform composite-based multispectral satellite baselines (weighted F1 = 0.83 vs. 0.80; macro F1 = 0.55 vs. 0.50), reaching near-asymptotic accuracy with as few as 5\% of available training parcels and preserving ecologically meaningful structure aligned with functional and taxonomic groupings. However, realising this advantage requires a nonlinear classifier: a compact neural network provides better results than classic machine learning (i.e. Random Forest) and performs as well as deeper neural networks, while a linear classifier on foundation-model embeddings underperforms a neural network on conventional composites. Ancillary environmental covariates offer no additional classification benefit when added to embedding-based models. Classification accuracy remains robust to moderate levels of label impurity, allowing mixed parcels to be retained in the training dataset without substantial penalties, while training with parcel-level species proportions as soft labels achieves higher peak performance (macro F1 = 0.586 for Tessera, 0.589 for AlphaEarth) and lower Proportion L1 error than hard labels without requiring purity filtering, maximising the value of the full range of input data. However, temporal transfer across years reveals performance degradation, with weighted F1 declining by 9\% for Tessera and 15\% for AlphaEarth, and disproportionate losses for rare species. Overall, our results show that geospatial foundation models shift a primary bottleneck in species mapping from feature engineering toward the availability, quality, and temporal alignment of ecological reference data, while opening new opportunities for scalable biodiversity monitoring and the analysis of ecological change.},
	language = {en},
	urldate = {2026-07-09},
	publisher = {bioRxiv},
	author = {Ball, James GC and Wicklein, Jana Annika and Feng, Zhengpeng and Knezevic, Jovana and Jaffer, Sadiq and Madhavapeddy, Anil and Atzberger, Clement and Dalponte, Michele and Coomes, David},
	month = mar,
	year = {2026},
	note = {ISSN: 2692-8205
Pages: 2026.02.23.707022
Section: New Results},
	keywords = {deep, rs},
	file = {Full Text PDF:/home/bene/Zotero/storage/YHN5PWXW/Ball et al. - 2026 - Geospatial foundation models enable data-efficient tree species mapping in temperate mountain forest.pdf:application/pdf},
}

