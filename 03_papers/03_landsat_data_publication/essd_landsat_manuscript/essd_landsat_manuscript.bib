@misc{fischer_global_2025,
	title = {The {Global} {Canopy} {Atlas}: analysis-ready maps of {3D} structure for the world's woody ecosystems},
	copyright = {\copyright{} 2025, Posted by Cold Spring Harbor Laboratory. This pre-print is available under a Creative Commons License (Attribution 4.0 International), CC BY 4.0, as described at http://creativecommons.org/licenses/by/4.0/},
	shorttitle = {The {Global} {Canopy} {Atlas}},
	url = {https://www.biorxiv.org/content/10.1101/2025.08.31.673375v2},
	doi = {10.1101/2025.08.31.673375},
	abstract = {Woody canopies regulate exchanges of energy, water and carbon, and their three-dimensional (3D) structure supports much of terrestrial biodiversity. Remote sensing technologies such as airborne laser scanning (ALS) now enable the 3D mapping of entire landscapes. However, we lack the large, harmonized and geographically representative ALS collections needed to build a global picture of woody ecosystem structure. To address this challenge, we developed the Global Canopy Atlas (GCA): 3,458 ALS acquisitions transformed into standardized and analysis-ready maps of canopy height and elevation at 1 m2 resolution. The GCA covers 56,554 km2 across all major biomes. 19\% of this area has been scanned multiple times, and 87\% of all GCA products are openly available, covering 95\% of the total area. To showcase its wide range of applications, we applied the GCA in three case studies. First, we validated three global satellite-derived canopy height maps, finding poor performance at native resolution (1-30 m, R2 {\textless} 0.38) and moderate performance at 250 m resolution (R2 {\textless} 0.65). Second, analyzing global patterns in canopy gap size frequency we discovered an unexpectedly large variation of power law exponents from branch to stand level ($\alpha$ = 1.52 to 2.38), pointing to a fundamental scale-dependence of forest structure. Third, we developed a framework to standardize forest turnover quantification from multi-source, multi-temporal ALS. In a temperate forest in North America it revealed that 21\% of canopy gaps closed within 12 years of opening and would thus be missed by infrequent monitoring. As demonstrated by these case studies, the GCA provides a novel data source for ecologists, foresters, remote sensing scientists and the ecosystem modelling community that substantially advances our ability to understand the structure and dynamics of woody ecosystems at global scales.},
	language = {en},
	urldate = {2025-09-11},
	publisher = {bioRxiv},
	author = {Fischer, Fabian J{\"o}rg and Morgan, Becky and Jackson, Toby and Chave, J{\'e}r{\^o}me and Coomes, David and Cushman, K. C. and Dalagnol, Ricardo and Dalponte, Michele and Duncanson, Laura and Saatchi, Sassan and Seidl, Rupert and Stere{\'n}czak, Krzysztof and Laurin, Gaia Vaglio and Adu-Bredu, Stephen and Aguirre-Guti{\'e}rrez, Jes{\'u}s and Antonielli, Benedetta and Armston, John David and Assis, Mauro LR de and Barbier, Nicolas and Burt, Andrew and C{\'e}sar, Ricardo Gomes and Cervenka, Jaroslav and Coops, Nicholas and Cullen, Laury and Dalling, James W. and Davies, Andrew and Demol, Miro and Ebenbeck, Jakob and Fassnacht, Fabian and Fatoyinbo, Lola and Garc{\'i}a, Mariano and Gasparri, N. Ignacio and Gobakken, Terje and Goodbody, Tristan R. H. and G{\"o}rgens, Eric Bastos and Gorum, Tolga and Gosper, Carl and Guan, Hongcan and Heiskanen, Janne and Heurich, Marco and Hobi, Martina and H{\"o}fle, Bernhard and Hooijer, Al and Huth, Andreas and Kedrov, Alexander and Kellner, James R. and Koenig, Simon and Kr{\'a}l, Kamil and Krassovski, Misha and Kuechly, Helga and Kr{\r u}{\v c}ek, Martin and Htoo, Kyaw Kyaw and Labri{\`e}re, Nicolas and Lai, Daphne and Larson, Johannes and Laudon, Hjalmar and Lemke, Dawn and Lenoir, Jonathan and Malhi, Yadvinder and Malik, Owais Ahmed and Martin, Maxence and McNicol, Iain and Milenkovic, Milutin and Minor, David and Mitchard, Ed and Moudr{\'y}, V{\'i}t{\v e}zslav and Muller-Landau, Helene C. and N{\ae}sset, Erik and Nathalang, Anuttara and Ometto, Jean Pierre and Onishi, Masanori and Onoda, Yusuke and Pellikka, Petri and Persson, Henrik and Ferreira, Matheus Pinheiro and Ploton, Pierre and Prober, Suzanne M. and Rahman, Farhadur and Rana, Parvez and R{\'e}jou-M{\'e}chain, Maxime and Sch{\"a}fer, Jannika and Senf, Cornelius and Shapiro, Aur{\'e}lie and Schepaschenko, Dmitry and Shen, Guochun and Silman, Miles and Silva, Thiago and Singh, Jenia and Slik, Ferry and Stillhard, Jonas and Subash, Anto and Takeshige, Ryuichi a